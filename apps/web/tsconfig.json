{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "paths": {
      "@canopy/graph": ["../../packages/graph/src/index.ts"],
      "@canopy/graph-access": ["../../packages/graph-access/src/index.ts"],
      "@canopy/plugin-host": ["../../packages/plugin-host/src/index.ts"],
      "@canopy/queries": ["../../packages/queries/src/index.ts"],
      "@canopy/settings": ["../../packages/settings/src/index.ts"],
      "@canopy/storage": ["../../packages/storage/src/index.ts"],
      "@canopy/storage-indexeddb": ["../../packages/storage-indexeddb/src/index.ts"],
      "canopy:graph/draft-session": ["./src/plugin/draft-session-shim.ts"]
    },
    "composite": false,
    "noEmit": true
  },
  "include": ["src/**/*", "e2e/**/*", ".storybook/**/*", "*.ts"],
  "exclude": []
}
