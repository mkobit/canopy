{
  "name": "@canopy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:wit": "bun run scripts/wit-codegen.ts && bun run scripts/package-plugin.ts",
    "package:plugin": "bun run scripts/package-plugin.ts",
    "build": "bun run codegen:wit && tsc && vite build",
    "dev": "vite",
    "dev:demo": "VITE_CANOPY_DEMO_SEED=true vite",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "bun test ./src --preload ./src/test/setup.ts",
    "test:e2e": "playwright test",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build -o .storybook-static"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.31.0",
    "@canopy/graph": "workspace:*",
    "@canopy/graph-access": "workspace:*",
    "@canopy/plugin-host": "workspace:*",
    "@canopy/queries": "workspace:*",
    "@canopy/settings": "workspace:*",
    "@canopy/storage": "workspace:*",
    "@canopy/storage-indexeddb": "workspace:*",
    "dompurify": "^3.4.17",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remeda": "^2.52.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.41.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.32",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  }
}
