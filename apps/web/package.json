{
  "name": "@canopy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:wit": "bun run scripts/wit-codegen.ts && bun run scripts/package-plugin.ts",
    "package:plugin": "bun run scripts/package-plugin.ts",
    "build": "bun run codegen:wit && tsc && vite build",
    "dev": "vite",
    "dev:demo": "VITE_CANOPY_DEMO_SEED=true vite",
    "typecheck": "bun run codegen:wit && tsc -p tsconfig.check.json",
    "test": "bun test ./src --preload ./src/test/setup.ts",
    "test:e2e": "playwright test",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build -o .storybook-static"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.19.0",
    "@canopy/api-adapter": "workspace:*",
    "@canopy/graph": "workspace:*",
    "@canopy/queries": "workspace:*",
    "@canopy/settings": "workspace:*",
    "@canopy/storage": "workspace:*",
    "@canopy/storage-indexeddb": "workspace:*",
    "dompurify": "^3.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remeda": "^2.39.0",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.24.6",
    "@happy-dom/global-registrator": "^20.11.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.4.0",
    "postcss": "^8.5.19",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.3",
    "vite": "^8.2.0"
  }
}
