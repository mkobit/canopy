{
  "name": "canopy-graph",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build": "tsc -b && bun --filter './apps/*' build",
    "check:api-compatibility": "bun tools/check-api-compatibility.ts",
    "check:versions": "bun tools/verify-versions.ts",
    "check:sbx-env": "bun scripts/check-sbx-env.ts",
    "check:unused": "knip",
    "check:eslint-disable-ceiling": "bun tools/check-eslint-disable-ceiling.ts",
    "check:dependency-graph": "bun tools/check-dependency-graph.ts",
    "check:plugin-artifacts": "bun tools/check-plugin-artifacts.ts",
    "check:built-package-exports": "bun tools/check-built-package-exports.ts",
    "check:ci-tooling": "bun tools/check-ci-tooling.ts",
    "refactor:check": "bun tools/refactor-ts.ts --check",
    "refactor:fix": "bun tools/refactor-ts.ts --fix",
    "audit:ai-tools": "bun tools/audit-ai-tool-releases.ts",
    "audit:beads": "bun tools/audit-beads-conventions.ts",
    "test": "bun --filter '*' test",
    "dev:demo": "bun --filter @canopy/web dev:demo",
    "lint": "bun tools/check-commands.ts && bun run check:versions && bun run check:api-compatibility && bun run check:unused && bun tools/lint-workspaces.ts && bun run check:eslint-disable-ceiling && bun run check:dependency-graph && bun run check:plugin-artifacts && bun run check:built-package-exports && bun run check:ci-tooling",
    "format": "prettier --write .",
    "typecheck": "bun --filter '*' typecheck",
    "storybook": "bun --filter '@canopy/web' storybook",
    "build-storybook": "bun --filter '@canopy/web' build-storybook",
    "prepare": "husky",
    "preinstall": "node -e \"console.error('Error: use bun'); process.exit(1)\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "temporal-polyfill": "^1.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "uuid": "^14.0.3",
    "zod": "^4.4.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.3"
  }
}
