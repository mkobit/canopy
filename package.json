{
  "name": "canopy-graph",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "PATH=\"$PWD/node_modules/typescript-native/bin:$PATH\" tsc -b && bun --filter './apps/*' build",
    "check:api-compatibility": "bun tools/check-api-compatibility.ts",
    "check:versions": "bun tools/verify-versions.ts",
    "check:openspec-changes": "bun tools/check-openspec-changes.ts",
    "check:unused": "knip",
    "audit:ai-tools": "bun tools/audit-ai-tool-releases.ts",
    "test": "bun --filter '*' test",
    "lint": "bun tools/check-commands.ts && bun run check:versions && bun run check:api-compatibility && eslint . --cache",
    "format": "prettier --write .",
    "typecheck": "PATH=\"$PWD/node_modules/typescript-native/bin:$PATH\" bun --filter '*' typecheck",
    "storybook": "bun --filter '@canopy/web' storybook",
    "build-storybook": "bun --filter '@canopy/web' build-storybook",
    "prepare": "husky",
    "preinstall": "node -e \"console.error('Error: use bun'); process.exit(1)\""
  },
  "overrides": {
    "@typescript-eslint/utils": "8.54.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^5.45.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.59.1",
    "uuid": "^14.0.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
