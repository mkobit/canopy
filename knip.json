{
  "$schema": "https://unpkg.com/knip@5/schemas/jsonconfig.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": [],
      "entry": [
        ".claude/hooks/*.ts"
      ]
    },
    "tools": {
      "entry": [
        "*.ts",
        "hooks/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/plugin/mock/guest.ts",
        "src/plugin/markdown/guest.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "happy-dom",
        "tailwindcss",
        "canopy",
        "@bytecodealliance/jco"
      ]
    },
    "apps/cli": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/daemon": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/extension": {
      "entry": [
        "src/background/service-worker.ts",
        "src/content/content-script.ts",
        "src/popup/popup.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}