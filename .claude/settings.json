{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bun tools/hooks/openspec-validate-hook.ts",
            "type": "command"
          },
          {
            "command": "bun tools/hooks/agent-format-lint-hook.ts",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mise exec:*)",
      "Bash(mise run check-unused)",
      "Bash(mise run test)",
      "Bash(mise run build)",
      "Bash(mise run lint)",
      "Bash(mise run typecheck)",
      "Bash(mise run check)",
      "Bash(mise run bd-push)",
      "Bash(mise run bd-sync)",
      "Bash(mise run bd-check)",
      "Bash(mise run spec-list)",
      "Bash(mise run spec-validate)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run format)",
      "Bash(bun run dev)",
      "Bash(bun run check:api-compatibility)",
      "Bash(bun run check:versions)",
      "Bash(bun run check:openspec-changes)",
      "Bash(bun run audit:ai-tools)",
      "Bash(bun run storybook)",
      "Bash(bun run build-storybook)",
      "Bash(bun run codegen:wit)",
      "Bash(bun run package:plugin)",
      "Bash(bun run test:e2e)",
      "Bash(bun run --cwd apps/web codegen:wit)",
      "Bash(bun tools/*)",
      "Bash(bun test *)",
      "Bash(bunx openspec *)"
    ]
  }
}
